    "No log events match your query.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Protokollereignisse entsprechen deiner Suchanfrage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν συμβάντα καταγραφής που να ταιριάζουν με το ερώτημά σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay eventos de registro que coincidan con tu búsqueda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksikään lokitapahtuma ei vastaa hakuasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento di log corrisponde alla ricerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement ne correspond à ta recherche."
          }
        }
      }
    },
    "No log file available. Enable file logging above to generate logs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Protokolldatei verfügbar. Aktiviere oben die Dateiprotokollierung, um Protokolle zu erstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει διαθέσιμο αρχείο καταγραφής. Ενεργοποιήστε την καταγραφή αρχείου παραπάνω για να δημιουργήσετε αρχεία καταγραφής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay archivo de registro disponible. Activa el registro en archivo arriba para generar registros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokitiedostoa ei ole saatavilla. Ota lokitus käyttöön ylhäältä luodaksesi lokitiedoston."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file di registro disponibile. Abilita la registrazione dei log sopra per generarne uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier de journal. Active son enregistrement pour en créer un."
          }
        }
      }
    },
