    "Press the **ENT** button for **5 seconds** to open **Full screen navigation**.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die **ENT**-Taste für **5 Sekunden**, um die **Vollbild-Navigation** zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το κουμπί **ENT** για **5 δευτερόλεπτα** για να ανοίξετε την **Πλοήγηση πλήρους οθόνης**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón **ENT** durante **5 segundos** para abrir la **Navegación a pantalla completa**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina **ENT**-painiketta **5 sekunnin** ajan avataksesi **Koko näytön navigoinnin**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il pulsante **ENT** per **5 secondi** per aprire la **Navigazione a schermo intero**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens **ENT pendant 5 secondes** pour ouvrir **Navigation plein écran**."
          }
        }
      }
    },
    "Press the **SET** button for **5 seconds** to open the motorcycle's navigation menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die **SET**-Taste für **5 Sekunden**, um das Navigationsmenü des Motorrads zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το κουμπί **SET** για **5 δευτερόλεπτα** για να ανοίξετε το μενού πλοήγησης της μοτοσυκλέτας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón **SET** durante **5 segundos** para abrir el menú de navegación de la moto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina **SET**-painiketta **5 sekunnin** ajan avataksesi moottoripyörän navigointivalikon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il pulsante **SET** per **5 secondi** per aprire il menu di navigazione della moto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens **SET pendant 5 secondes** pour ouvrir le menu de navigation de la Kove."
          }
        }
      }
    },
