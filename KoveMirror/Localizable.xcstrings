    "Configure display resolution, screen margins, proximity sensing, and diagnostics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguriere Displayauflösung, Bildschirmränder, Näherungserkennung und Diagnose."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαμορφώστε την ανάλυση οθόνης, τα περιθώρια, τον αισθητήρα εγγύτητας και τα διαγνωστικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la resolución de pantalla, márgenes, sensor de proximidad y diagnósticos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä näytön tarkkuus, reunamarginaalit, läheisyystunnistus ja diagnostiikka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la risoluzione dello schermo, i margini, il sensore di prossimità e la diagnostica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle l’affichage, les marges, la détection de proximité et le journal de connexion."
          }
        }
      }
    },
