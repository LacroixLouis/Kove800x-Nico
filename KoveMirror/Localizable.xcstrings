    "Automatic Screen Launch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatischer Bildschirmstart"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματη εκκίνηση οθόνης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio automático de pantalla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen näytön käynnistys"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvio automatico dello schermo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture automatique"
          }
        }
      }
    },
    "Automatically streams the in-app dashboard views. When you broadcast the entire screen, it seamlessly switches to the broadcast stream, falling back dynamically on exit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgt automatisch die Ansichten des In-App-Dashboards. Wenn du den gesamten Bildschirm überträgst, wird nahtlos zum Übertragungsstream gewechselt und beim Beenden dynamisch zurückgekehrt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταδίδει αυτόματα τις προβολές του πίνακα οργάνων της εφαρμογής. Όταν μεταδίδετε ολόκληρη την οθόνη, μεταβαίνει ομαλά στη ροή μετάδοσης, επιστρέφοντας δυναμικά κατά την έξοδο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmite automáticamente las vistas del panel dentro de la app. Al transmitir la pantalla completa, cambia sin problemas a la transmisión completa y regresa dinámicamente al salir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Striimaa automaattisesti sovelluksen sisäisiä näkymiä. Kun peilaat koko näytön, se siirtyy saumattomasti järjestelmäpeilaukseen ja palaa takaisin poistuttaessa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmette automaticamente le schermate dell'app. Quando trasmetti l'intero schermo, passa in modo fluido al flusso di trasmissione, ripristinando la visuale dell'app alla chiusura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffuse d’abord l’interface de NicoMirror. La diffusion système prend ensuite le relais lorsque tu l’autorises."
          }
        }
      }
    },
